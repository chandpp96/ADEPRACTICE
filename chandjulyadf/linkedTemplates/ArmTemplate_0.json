{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "chandjulyadf"
		},
		"ADLS_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS_LS'"
		},
		"SQL DB LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SQL DB LS'"
		},
		"ADLS_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://chandjulystorage.dfs.core.windows.net/"
		},
		"SQL DB LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "chand6db.database.windows.net"
		},
		"SQL DB LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "chand6db"
		},
		"SQL DB LS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "chand6db"
		}
	},
