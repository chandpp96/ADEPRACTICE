							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "select TABLE_SCHEMA,TABLE_NAME from information_schema.tables where \ntable_type='BASE TABLE' AND\nTABLE_SCHEMA='SalesLT'",
								"queryTimeout": "00:05:00",
								"isolationLevel": "ReadUncommitted",
								"partitionOption": "None"
							},
